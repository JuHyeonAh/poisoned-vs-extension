{
  "name": "poisoned-extension",
  "displayName": "Poisoned VS Extension",
  "description": "포이즈닝된 GPT 모델을 활용한 VS Code 확장",
  "version": "0.0.8",
  "publisher": "hajoo",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:extension.requestCodeFromGPT"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.requestCodeFromGPT",
        "title": "Request Code from GPT"
      }
    ],
    "keybindings": [
      {
        "key": "cmd+shift+s",
        "command": "extension.requestCodeFromGPT",
        "when": "editorTextFocus"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JuHyeonAh/poisoned-vs-extension.git"
  },
  "scripts": {
    "compile": "tsc -p ./",
    "build": "webpack --mode=production",
    "watch": "webpack --watch --mode=development",
    "pretest": "npm run build",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/node-fetch": "^2.6.12",
    "@types/vscode": "^1.99.1",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "webpack": "^5.99.9",
    "webpack-cli": "^4.10.0"
  },
  "dependencies": {
    "node-fetch": "^2.7.0"
  }
}
